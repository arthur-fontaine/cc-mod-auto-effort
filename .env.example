# Read by the mod from the environment Claude Code runs in, and by `pnpm eval` from .env.
# All three are required; the mod calls nothing until they are set.
AUTO_EFFORT_ENDPOINT=
AUTO_EFFORT_API_KEY=
AUTO_EFFORT_MODEL=

# OpenCode Zen: AUTO_EFFORT_ENDPOINT=https://opencode.ai/zen/v1/systemone  AUTO_EFFORT_MODEL=jev-1.13
# TypeSafe:     AUTO_EFFORT_ENDPOINT=https://api.typesafe.ai/v1/systemone  AUTO_EFFORT_MODEL=jev-latest
